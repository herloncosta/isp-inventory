DATABASE_URL="postgresql://isp:isp_password@localhost:5432/isp_inventory?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3000
# Origens que podem chamar a API cross-origin com cookie. Vazio = só a mesma
# origem (é o padrão, e é o que basta com o proxy /api do Vite).
CORS_ORIGINS=""
# Atributo Secure nos cookies de sessão. Vazio = true em produção e false fora;
# force nos dois sentidos quando NODE_ENV não contar a história (proxy, túnel).
COOKIE_SECURE=""
