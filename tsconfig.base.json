{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@isp/shared": ["apps/shared/src/index.ts"],
      "@isp/shared/*": ["apps/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "generated"]
}
