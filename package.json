{
  "name": "isp-inventory",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema de Gestão e Controle de Estoque Telecom",
  "scripts": {
    "predev": "pnpm --filter shared build",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter shared build && pnpm --parallel --filter './apps/*' build",
    "test": "pnpm --filter api test",
    "lint": "pnpm --parallel --filter './apps/*' lint",
    "lint:fix": "pnpm --parallel --filter './apps/*' lint:fix",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:studio": "pnpm --filter api exec prisma studio",
    "postinstall": "pnpm --filter api run prisma:generate"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.0.0"
}
